# Demo LLM dasar.
#
# Butuh API key:  GROQ_API_KEY=sk-... aksara contoh_llm.ak

impor "llm.ak" sbg llm

cetak llm.tulis_puisi("bahasa pemrograman Indonesia bernama Aksara")
cetak llm.ringkas_teks("Aksara adalah bahasa pemrograman dengan sintaks bahasa Indonesia, "
                       + "dilengkapi AI built-in, kompiler ke Python, dan REPL interaktif.")